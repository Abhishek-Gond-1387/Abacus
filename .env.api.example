# Copy to .env.api and replace secrets with unique random values of at least 32 characters.
ABACUS_API_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
# For multiple clients, set this instead of ABACUS_API_KEY (single-quoted JSON in PowerShell):
# ABACUS_CLIENT_API_KEYS='{"default":"replace-with-a-unique-secret","client-two":"replace-with-another-secret"}'
DB_PASSWORD=replace-this-with-a-random-url-safe-database-password
ABACUS_PORT=8000
# Optional: daily backup cadence and retention in seconds/days.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
