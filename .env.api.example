# Copy to .env.api and replace every placeholder with unique random values of at least 32 characters.
ABACUS_API_KEY=replace-this-with-a-random-secret-of-at-least-32-characters
# For per-client roles and quotas, set ABACUS_CLIENT_API_KEYS and leave ABACUS_API_KEY blank.
# Each entry is either a legacy key string or an object with api_key, role, daily_run_limit, max_active_runs.
# ABACUS_CLIENT_API_KEYS='{"default":{"api_key":"replace-with-unique-key","role":"admin","daily_run_limit":100,"max_active_runs":3},"client-two":{"api_key":"replace-with-unique-key","role":"member","daily_run_limit":25,"max_active_runs":2}}'
DB_PASSWORD=replace-this-with-a-random-url-safe-database-password
ABACUS_APP_PASSWORD=replace-this-with-a-different-random-url-safe-database-password
ABACUS_PORT=8000
# Optional: daily backup cadence and retention in seconds/days.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=14
# Optional public HTTPS: set a DNS name pointing to this host, then start with --profile production.
# ABACUS_DOMAIN=api.example.com
# Optional AWS S3 encrypted offsite backup: use --profile offsite-backup after creating the bucket/KMS key.
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=replace-with-a-dedicated-minimum-privilege-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret
# AWS_SESSION_TOKEN=replace-if-using-temporary-credentials
# S3_BACKUP_URI=s3://your-bucket/abacus/database
# S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/replace-with-key-id
# S3_BACKUP_INTERVAL_SECONDS=300
# Optional free offsite copy: OneDrive must be installed and signed in on the Compose host.
# Set this to a local folder inside the OneDrive sync root, then use --profile onedrive-backup.
# ABACUS_ONEDRIVE_BACKUP_DIR=C:/Users/<WindowsUser>/OneDrive/AbacusBackups
